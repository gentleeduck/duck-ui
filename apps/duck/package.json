  "name": "@gentleduck/ui-docs",
  "author": "gentleduck contributors",
  "license": "MIT",
  "homepage": "https://www.gentleduck.org",
  "bugs": {
    "url": "https://github.com/gentleeduck/gentleduck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/gentleduck.git",
    "directory": "apps/duck-ui-docs"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "MODE=\"production\" next build",
    "build:prod": "next build",
    "build:docs": "node scripts/build-changelogs.mjs && duck-md build && bun scripts/build-search-index.mjs && node scripts/build-llm-pages.mjs",
    "build:reg": "bun run build:reg:cli && bun run format:reg",
    "build:reg:cli": "registry-build build",
    "dev": "next dev",
    "dev:docs": "duck-md dev",
    "format:reg": "bunx biome format --write ./__ui_registry__/index.tsx",
    "lint": "biome check .",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck",
    "postbuild": "node scripts/patch-nft.mjs && next-sitemap",
    "start": "next start --port 3008",
    "preview": "next build && next start"
  },
  "browserslist": [
    "Chrome >= 110",
    "Edge >= 110",
    "Firefox >= 110",
    "Safari >= 16",
    "iOS >= 16",
    "ChromeAndroid >= 110"
  ],
  "version": "3.0.21"
}
