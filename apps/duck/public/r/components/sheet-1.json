      "content": "'use client'\n\nimport { Button } from '@gentleduck/registry-ui/button'\nimport { Input } from '@gentleduck/registry-ui/input'\nimport { Label } from '@gentleduck/registry-ui/label'\nimport {\n  Sheet,\n  SheetClose,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from '@gentleduck/registry-ui/sheet'\n\nconst SHEET_SIDES = ['right'] as const\n\nexport default function Demo() {\n  return (\n    <div className=\"grid grid-cols-1 gap-2\">\n      {SHEET_SIDES.map((side) => (\n        <Sheet key={side}>\n          <SheetTrigger asChild>\n            <Button variant={'outline'}>{side}</Button>\n          </SheetTrigger>\n          <SheetContent side={side}>\n            <SheetHeader>\n              <SheetTitle>Edit profile</SheetTitle>\n              <SheetDescription>Make changes to your profile here. Click save when you're done.</SheetDescription>\n            </SheetHeader>\n            <div className=\"flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto py-4\">\n              <div className=\"grid grid-cols-4 items-center gap-4\">\n                <Label htmlFor=\"name\">Name</Label>\n                <Input className=\"col-span-3\" id=\"name\" defaultValue=\"Pedro Duarte\" />\n              </div>\n              <div className=\"grid grid-cols-4 items-center gap-4\">\n                <Label htmlFor=\"username\">Username</Label>\n                <Input className=\"col-span-3\" id=\"username\" defaultValue=\"@peduarte\" />\n              </div>\n            </div>\n            <SheetFooter className=\"mt-2\">\n              <SheetClose asChild>\n                <Button>Save changes</Button>\n              </SheetClose>\n            </SheetFooter>\n          </SheetContent>\n        </Sheet>\n      ))}\n    </div>\n  )\n}\n",
      "path": "sheet/sheet-1.tsx",
      "target": "components/sheet-1.tsx",
      "type": "registry:example"
    }
  ],
