{
  "$schema": "https://json.schemastore.org/package.json",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "author": "gentleduck contributors",
  "bugs": {
    "url": "https://github.com/gentleeduck/gentleduck/issues"
  },
  "dependencies": {
    "@gentleduck/motion": "workspace:*",
    "@tailwindcss/vite": "^4.1.17",
    "axios": "^1.13.2",
    "lucide-react": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "description": "Browser extension for font customization and typography control.",
  "devDependencies": {
    "@gentleduck/libs": "workspace:*",
    "@gentleduck/registry-ui": "workspace:*",
    "@gentleduck/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/chrome": "^0.1.31",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.2.0",
    "tsdown": "catalog:",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.2.4",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.3",
    "vite": "catalog:",
    "vite-plugin-web-extension": "^4.5.0"
  },
  "exports": {
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.app.json",
    "tsconfig.node.json"
  ],
  "homepage": "https://gentleduck.org/duck-ui",
  "keywords": [
    "gentleduck",
    "browser-extension",
    "fonts",
    "typography"
  ],
  "license": "MIT",
  "main": "./index.ts",
  "name": "@gentleduck/duck-extension",
  "packageManager": "bun@1.3.10",
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentleeduck/gentleduck.git",
    "directory": "packages/duck-extension"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:chrome": "rm -rf dist && bun run build && cp manifest-chrome.json dist/manifest.json",
    "build:firefox": "rm -rf dist && bun run build && cp manifest-firefox.json dist/manifest.json",
    "dev": "vite",
    "package": "bun run build:chrome && bun run zip:chrome && bun run build:firefox && bun run zip:firefox && rm -rf dist",
    "preview": "vite preview",
    "zip:chrome": "cd ./dist && zip -r ../releases/duck-chrome-v1.zip ./* && cd ..",
    "zip:firefox": "cd ./dist && zip -r ../releases/duck-firefox-v1.zip ./* && cd ..",
    "check-types": "tsc -p tsconfig.json --noEmit --pretty false --skipLibCheck"
  },
  "type": "module",
  "version": "1.0.12"
}
