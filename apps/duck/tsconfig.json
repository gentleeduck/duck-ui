{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "noErrorTruncation": true,
    "paths": {
      "~/*": ["./*"],
      "@gentleduck/registry-internals/*": ["../../packages/registry-internals/src/*"],
      "~/gentleduck": ["./.gentleduck/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "types": ["@types/react", "node", "./types/index.d.ts"],
    "useDefineForClassFields": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/__test__/**",
    "**/__tests__/**",
    "**/__stories__/**",
    "**/__benches__/**",
    "**/*.test.ts"
  ],
  "extends": "@gentleduck/typescript-config/nextjs.json",
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".gentleduck"]
}
